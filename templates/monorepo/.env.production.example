# Generate and retain a 32-byte base64 key; do not commit the real value.
ASPNETCORE_ENVIRONMENT=Production
Yard__Name=YardApp
Yard__Database=__DATABASE__
Yard__ConnectionString=
Yard__VerificationKey=
Yard__PublicOrigin=https://example.com
Yard__KeysDirectory=/var/lib/yardapp/keys
Yard__Mail__Host=
Yard__Mail__Port=587
Yard__Mail__Username=
Yard__Mail__Password=
Yard__Mail__FromAddress=
Yard__Mail__FromName=YardApp
Yard__Mail__Tls=StartTls
Yard__GitHub__Enabled=false
Yard__GitHub__ClientId=
Yard__GitHub__ClientSecret=
