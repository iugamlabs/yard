{
  "$schema": "http://json.schemastore.org/template",
  "author": "Iugam",
  "classifications": [
    "Yard",
    "Monorepo"
  ],
  "identity": "Iugam.Yard.Monorepo",
  "name": "Yard standard monorepo",
  "shortName": "yard-mono",
  "sourceName": "YardApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "postgresql"
        },
        {
          "choice": "sqlite"
        }
      ],
      "defaultValue": "postgresql",
      "replaces": "__DATABASE__"
    },
    "packageName": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      },
      "replaces": "yardapp"
    },
    "providerPackage": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "cases": [
          {
            "condition": "(database == \"sqlite\")",
            "value": "Microsoft.EntityFrameworkCore.Sqlite"
          },
          {
            "condition": "(database == \"postgresql\")",
            "value": "Npgsql.EntityFrameworkCore.PostgreSQL"
          }
        ]
      },
      "replaces": "__PROVIDER_PACKAGE__"
    }
  },
  "sources": [
    {
      "exclude": [
        "**/bin/**",
        "**/obj/**",
        "**/node_modules/**",
        ".template.config/**",
        "**/.DS_Store",
        "providers/**"
      ]
    },
    {
      "source": "providers/sqlite",
      "target": "apps/api",
      "condition": "(database == \"sqlite\")"
    },
    {
      "source": "providers/postgresql",
      "target": "apps/api",
      "condition": "(database == \"postgresql\")"
    }
  ]
}
