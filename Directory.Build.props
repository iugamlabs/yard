<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>0.1.0</Version><Authors>Iugam</Authors><PackageLicenseExpression>Apache-2.0</PackageLicenseExpression><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><Deterministic>true</Deterministic><PackageReadmeFile>README.md</PackageReadmeFile><Description>Convention-first C# and React monorepo tooling and application foundation.</Description></PropertyGroup><ItemGroup><None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/"/></ItemGroup></Project>
